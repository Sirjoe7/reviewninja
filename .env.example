# Copy to .env.local and fill in. Only NEXT_PUBLIC_ values are used.
NEXT_PUBLIC_SITE_URL=https://www.example.com
NEXT_PUBLIC_CONTACT_EMAIL=theamazonreviewer@gmail.com
# Digits only, with country code, e.g. 254700000000
NEXT_PUBLIC_WHATSAPP=254778210955
NEXT_PUBLIC_ADDRESS=
# Form service endpoint, e.g. https://formspree.io/f/xxxx or https://api.web3forms.com/submit
NEXT_PUBLIC_FORM_ENDPOINT=
# Web3Forms only
NEXT_PUBLIC_FORM_ACCESS_KEY=
